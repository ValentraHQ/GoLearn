# GoLearn configuration. Copy to .env and adjust; every variable is optional.
# Real secrets belong in your secret manager, never in git (.env is git-ignored).

# --- Server ---------------------------------------------------------------
GOLEARN_ADDR=:8080
GOLEARN_STATIC_DIR=web/dist          # built frontend; empty disables static serving
GOLEARN_COOKIE_SECURE=false          # set true behind HTTPS
GOLEARN_TRUST_PROXY=false            # true only behind ONE proxy you control that appends X-Forwarded-For
GOLEARN_BCRYPT_COST=12
GOLEARN_COOKIE_NAME=golearn_session
GOLEARN_SESSION_TTL=720h             # 30 days
# GOLEARN_ALLOW_ORIGIN=              # only for a separately hosted frontend (CORS with credentials)

# --- Database -------------------------------------------------------------
# sqlite:golearn.db for local use, postgres://... for production.
DATABASE_URL=sqlite:golearn.db
# DATABASE_URL=postgres://golearn:CHANGE-ME@localhost:5432/golearn?sslmode=disable

# --- Code execution -------------------------------------------------------
# disabled | docker (API talks to the local Docker daemon) | remote (runner-daemon)
GOLEARN_RUNNER=disabled
GOLEARN_RUNNER_IMAGE=golearn-runner:latest
# GOLEARN_DOCKER_BIN=docker
# Required for GOLEARN_RUNNER=remote, and for the runner-daemon itself.
# Use a random string of at least 16 characters, e.g. `openssl rand -hex 24`.
# GOLEARN_RUNNER_URL=http://runner:9090
# GOLEARN_RUNNER_TOKEN=
# GOLEARN_DOCKER_RUNTIME=runsc       # gVisor (recommended for public deployments)
GOLEARN_RUN_TIMEOUT=15s
GOLEARN_RUN_MEMORY_MB=512
GOLEARN_RUN_CPUS=1
GOLEARN_RUN_PIDS=256
GOLEARN_RUN_CONCURRENCY=4
GOLEARN_RUNS_PER_MINUTE=30

# --- Tests only -----------------------------------------------------------
# Run the store and API suites against PostgreSQL (one schema per test):
# GOLEARN_TEST_DATABASE_URL=postgres://golearn:golearn@localhost:5432/golearn?sslmode=disable
# Live end-to-end test against a running server:
# GOLEARN_E2E_URL=http://localhost:8080
